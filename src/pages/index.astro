---
import Base from '../layouts/Base.astro';
import Canvas from '../components/Canvas.astro';
import Chrome from '../components/Chrome.astro';
import Entry from '../components/Entry.astro';
import Premise from '../components/Premise.astro';
import Act from '../components/Act.astro';
import Station from '../components/Station.astro';
import Control from '../components/Control.astro';
import Close from '../components/Close.astro';
import { ACTS, DESTINATION_BY_ID, SECTIONS, type Act as ActContent } from '../content/experience.ts';

/**
 * The page is the spine. Nothing here decides order, copy or composition — it
 * only maps `SECTIONS` onto components, so `tools/check-layout.mjs` and the
 * rendered DOM are checking the same list.
 */
---

<Base>
  <Canvas />
  <Chrome />
  <main class="page" id="main">
    {
      SECTIONS.map((section) => {
        if (section.kind === 'entry') {
          return <Entry />;
        }
        if (section.kind === 'premise') {
          return <Premise />;
        }
        if (section.kind === 'act') {
          const act = ACTS.find((candidate) => candidate.id === section.act) as ActContent;
          return <Act act={act} param={section.param} />;
        }
        if (section.kind === 'station' && section.station !== null) {
          return (
            <Station
              destination={DESTINATION_BY_ID[section.station]}
              param={section.param}
              side={section.captionSide}
            />
          );
        }
        if (section.kind === 'control') {
          return <Control />;
        }
        return <Close />;
      })
    }
  </main>
</Base>
