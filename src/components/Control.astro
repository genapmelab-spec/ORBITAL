---
import { CONTROL, SECTION_BY_ID } from '../content/experience.ts';

/**
 * The product, unscripted. Everything before this point was authored; here the
 * visitor sets the date and the model recomputes every position in front of
 * them. It is also the page's proof: the numbers below the slider come from the
 * same orbital elements the scene uses, and they keep working without WebGL.
 */
---

<section
  class="section section--control"
  id="control"
  data-section
  data-id="control"
  data-param={SECTION_BY_ID.control.param}
  aria-labelledby="control-title"
>
  <div class="control__panel">
    <p class="u-mono" data-reveal>{CONTROL.kicker}</p>
    <h2 class="control__title" id="control-title" data-reveal>{CONTROL.title}</h2>
    <p class="control__body" data-reveal>{CONTROL.body}</p>

    <div class="control__time" data-reveal>
      <label class="u-mono" for="date-control">{CONTROL.label}</label>
      <input
        class="control__slider"
        id="date-control"
        type="range"
        min="-1095"
        max="1095"
        step="1"
        value="0"
        data-time-slider
        aria-describedby="date-readout"
      />
      <output class="control__readout u-mono" id="date-readout" for="date-control">
        <span data-time-days>today</span>
        <span aria-hidden="true">·</span>
        <time data-time-date datetime="">—</time>
      </output>
      <p class="control__live u-mono">
        {CONTROL.liveMetricLabel}
        <span data-time-metric>—</span>
      </p>
    </div>

    <div class="control__actions" data-reveal>
      <button class="button button--ghost" type="button" data-time-reset>{CONTROL.reset}</button>
      <a class="button button--ghost" href={CONTROL.restart.href}>{CONTROL.restart.label}</a>
      <button class="button button--ghost" type="button" data-share>
        <span data-share-label aria-live="polite">{CONTROL.share}</span>
      </button>
    </div>

    <p class="control__note u-mono" data-webgl-note hidden>{CONTROL.fallbackNote}</p>
  </div>
</section>
