---
import { HERO, NAV_STAGES } from '../content/mission';
---

<header class="site-nav" data-nav>
  <nav class="site-nav__bar" aria-label="Mission">
    <a class="brand" href="#leave" aria-label="ORBITAL, back to departure">
      <span class="brand__mark" aria-hidden="true">◈</span>
      <span>Orbital</span>
      <span class="brand__sys" aria-hidden="true">Sys</span>
    </a>

    <div class="nav-stages" data-nav-stages>
      {
        NAV_STAGES.map((stage) => (
          <a href={stage.href} data-stage-link={stage.index}>
            <i aria-hidden="true">{stage.index}</i> {stage.label}
          </a>
        ))
      }
    </div>

    <div class="nav-right">
      <span class="nav-status">Booking: standby</span>
      <a class="btn btn--ember" href="#secure">
        <span>{HERO.primary.label}</span>
      </a>
      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="nav-overlay"
        data-nav-toggle
      >
        <span class="sr-only">Open mission menu</span>
        <span class="nav-toggle__icon" aria-hidden="true"></span>
      </button>
    </div>
  </nav>
</header>

<div class="nav-scrim" data-nav-scrim hidden></div>

<div class="nav-overlay" id="nav-overlay" data-nav-overlay hidden>
  {
    NAV_STAGES.map((stage) => (
      <a class="nav-overlay__item" href={stage.href} data-overlay-link>
        <span aria-hidden="true">{stage.index}</span>
        {stage.label}
      </a>
    ))
  }
  <a class="btn btn--ember btn--large nav-overlay__cta" href="#secure" data-overlay-link>
    <span>{HERO.primary.label}</span>
  </a>
</div>
