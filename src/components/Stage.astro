---
import type { Stage } from '../content/journey';

/**
 * A stage window: a transparent section over one camera composition.
 *
 * Planets are landmarks, not pages. 'landmark' speaks the full caption,
 * 'minimal' drops to a name and one line, and 'silent' shows nothing at all —
 * the DOM still carries the screen-reader summary, so the story is complete
 * either way (AGENTS.md: all content in the DOM, none of it required on screen).
 */

export interface Props {
  stage: Stage;
  /** Camera parameter this section sits on: 0 at stage 01, 13 at stage 14. */
  param: number;
}

const { stage, param } = Astro.props;
const number = String(stage.index).padStart(2, '0');
const label = stage.kind.toUpperCase();
const silent = stage.weight === 'silent';
const showMeta = stage.weight === 'landmark';
---

<section
  class:list={['stage', silent && 'stage--silent']}
  id={stage.id}
  data-section
  data-kind="stage"
  data-stage={stage.id}
  data-param={param}
  data-caption-pos={stage.captionPos}
  aria-label={`Stage ${number} — ${stage.name}`}
>
  {
    !silent && (
      <div class="stage-caption" data-quiet={stage.quiet === true ? 'true' : undefined}>
        <p class="stage-index u-mono" data-reveal>
          <span>{number}</span>
          <span class="stage-rule" data-reveal-line />
          <span class="stage-kicker">{label}</span>
        </p>
        <h2 class="stage-name" data-reveal>{stage.name}</h2>
        <p class="stage-statement" data-reveal>{stage.statement}</p>
        {showMeta && (
          <ul class="stage-meta u-mono" data-reveal>
            {stage.meta.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )}
      </div>
    )
  }
  <p class="sr-only">{stage.summary}</p>
</section>
