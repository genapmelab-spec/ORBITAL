---
import { CLOSE, SECTION_BY_ID } from '../content/experience.ts';

/**
 * The sign-off. The action already happened one section earlier (the visitor
 * took the controls), so this is the quiet end: a statement, two ways back in,
 * and the colophon that says what the page is made of.
 */
---

<section
  class="section section--close"
  id="close"
  data-section
  data-id="close"
  data-param={SECTION_BY_ID.close.param}
  aria-labelledby="close-voice"
>
  <p class="close__voice" id="close-voice" data-reveal>{CLOSE.voice}</p>
  <p class="u-mono" data-reveal>{CLOSE.meta}</p>
  <div class="close__actions" data-reveal>
    <a class="button button--primary" href={CLOSE.primaryCta.href}>{CLOSE.primaryCta.label}</a>
    <button class="button button--ghost" type="button" data-share>
      <span data-share-label aria-live="polite">{CLOSE.share}</span>
    </button>
  </div>
  <footer class="colophon">
    <p>{CLOSE.colophon}</p>
  </footer>
</section>
