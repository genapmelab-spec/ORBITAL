---
import { PREMISE, SECTION_BY_ID } from '../content/experience.ts';

/**
 * What this is and why it exists. The page's own voice, so it sits in the
 * centred-but-off-grid zone: a serif statement, the argument, then three claims
 * the rest of the page will go on to prove.
 */
---

<section
  class="section section--premise"
  id="premise"
  data-section
  data-id="premise"
  data-param={SECTION_BY_ID.premise.param}
  aria-labelledby="premise-title"
>
  <div class="premise__grid">
    <p class="premise__kicker u-mono" data-reveal>{PREMISE.kicker}</p>
    <h2 class="premise__title" id="premise-title" data-reveal>{PREMISE.title}</h2>
    <p class="premise__body" data-reveal>{PREMISE.body}</p>
    <ol class="premise__claims">
      {
        PREMISE.claims.map((claim, index) => (
          <li class="claim" data-reveal>
            <p class="claim__index u-mono">{`0${index + 1}`}</p>
            <h3 class="claim__title">{claim.title}</h3>
            <p class="claim__line">{claim.line}</p>
          </li>
        ))
      }
    </ol>
    <a class="button button--primary premise__action" href={PREMISE.cta.href} data-reveal>
      {PREMISE.cta.label}
    </a>
  </div>
</section>
