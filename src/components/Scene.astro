---
import { ARRIVE, FLY, HERO } from '../content/mission';
---

<!--
  ONE persistent scene for the whole page: the canvas is fixed and is never
  swapped, remounted or duplicated (PRD acceptance criterion 2).
  aria-hidden because every message it carries also exists in the DOM.
-->
<div class="scene-layer" aria-hidden="true">
  <div class="css-stars"></div>
  <div class="css-horizon"></div>
  <canvas class="scene-canvas" data-scene-canvas></canvas>
</div>

<!--
  Annotation layer: these are DOM nodes positioned from real projected world
  coordinates every frame (src/three/anchors.ts). Not decoration over a
  screenshot — the porthole ring is the actual screen footprint of Mars.
-->
<div class="anchor-layer" aria-hidden="true" data-anchor-layer>
  <div class="anchor-chip" data-anchor="earth">
    <span class="anchor-chip__label">
      {HERO.telemetry[0].label} · <b>{HERO.telemetry[0].value}</b>
    </span>
    <span class="anchor-chip__tick"></span>
  </div>

  <div class="porthole" data-anchor="porthole">
    <svg viewBox="0 0 200 200">
      <circle class="porthole__ring" cx="100" cy="100" r="92"></circle>
      <circle class="porthole__ticks" cx="100" cy="100" r="81"></circle>
      <circle class="porthole__arc" cx="100" cy="100" r="92"></circle>
      <line class="porthole__cross" x1="100" y1="6" x2="100" y2="30"></line>
      <line class="porthole__cross" x1="100" y1="170" x2="100" y2="194"></line>
      <line class="porthole__cross" x1="6" y1="100" x2="30" y2="100"></line>
      <line class="porthole__cross" x1="170" y1="100" x2="194" y2="100"></line>
    </svg>
    <span class="mono mono--micro porthole__caption">
      {ARRIVE.anchor.label} · <b>{ARRIVE.anchor.value}</b>
    </span>
  </div>

  <div class="anchor-chip" data-anchor="craft">
    <span class="anchor-chip__label">
      {FLY.anchor.label} · <b>{FLY.anchor.value}</b>
    </span>
    <span class="anchor-chip__tick"></span>
  </div>
</div>

<script>
  import '../scripts/scene';
</script>
