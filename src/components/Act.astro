---
import type { Act as ActContent } from '../content/experience.ts';

interface Props {
  act: ActContent;
  param: number;
}

/**
 * A chapter break. Short on purpose: one line of voice, a name, and out — the
 * camera is already travelling somewhere while it is on screen.
 */
const { act, param } = Astro.props;
---

<section
  class="section section--act"
  id={act.id}
  data-section
  data-id={act.id}
  data-act={act.id}
  data-param={param}
  aria-labelledby={`${act.id}-name`}
>
  <p class="act__number u-mono">Act {act.number}</p>
  <h2 class="act__name" id={`${act.id}-name`} data-reveal>{act.name}</h2>
  <p class="act__line" data-reveal>{act.line}</p>
</section>
