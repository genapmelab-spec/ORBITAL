---
interface Props {
  /** anchor id, also used to derive the heading id */
  id: string;
  /** 0-based act index, published to the scene + stage indicator */
  act: number;
  /** composition modifier, e.g. "leave" → .act--leave */
  slug: string;
  /** mission-log eyebrow, e.g. "Log 002 · Cross" */
  log: string;
  /** plain-text act summary for screen readers, in place of the 3D subject */
  summary: string;
}

const { id, act, slug, log, summary } = Astro.props;
---

<!--
  Consistent act semantics, deliberately inconsistent composition: each act's
  inner layout is authored differently so no two viewports repeat a pattern
  (docs/DESIGN.md §7.2). The heading inside the slot must carry
  id={`${id}-heading`}.
-->
<section
  id={id}
  class={`act act--${slug}`}
  data-act={act}
  aria-labelledby={`${id}-heading`}
>
  <p class="sr-only">{summary}</p>
  <div class="act__inner">
    <p class="eyebrow act__eyebrow" data-reveal>
      <span>{log}</span>
    </p>
    <slot />
  </div>
</section>
