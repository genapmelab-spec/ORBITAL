---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ORBITAL — a spaceflight you can scroll',
  description = 'Five acts of silent, weightless flight: leave Earth, cross the void, arrive at Mars, fly the Orbital X1 Cruiser, and claim a seat at the horizon.',
} = Astro.props;

const origin = Astro.site?.origin ?? 'https://orbital.example';
const canonical = new URL(Astro.url.pathname, origin).href;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#030510" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600&display=swap"
    />

    <!--
      Pre-paint capability probe. It mirrors detectInitialStep() in
      src/three/quality.ts exactly (same thresholds, features only — never a
      user-agent string) so the CSS composition is chosen before first paint and
      no WebGL is ever created on a device that should not have it.
    -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.remove('no-js');
        root.classList.add('js');
        var skybox = false;
        try {
          var probe = document.createElement('canvas');
          var gl = probe.getContext('webgl2') || probe.getContext('webgl');
          var connection = navigator.connection || {};
          var memory = navigator.deviceMemory || 4;
          var cores = navigator.hardwareConcurrency || 4;
          var narrowCoarse =
            window.matchMedia('(max-width: 767px)').matches &&
            window.matchMedia('(pointer: coarse)').matches;
          skybox = !gl || narrowCoarse || connection.saveData === true || memory <= 2 || cores <= 2;
        } catch (error) {
          skybox = true;
        }
        if (skybox) root.classList.add('tier-skybox');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to mission content</a>
    <slot />
  </body>
</html>
